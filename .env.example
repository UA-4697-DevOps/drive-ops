# --- Database Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=<PUT_YOUR_DB_USER_HERE>
DB_PASSWORD=<PUT_YOUR_DB_PASSWORD_HERE>
# General database name or service-specific database names
TRIP_DB_NAME=trip_db
DRIVER_DB_NAME=driver_db

# --- Message Broker (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=<PUT_YOUR_MQ_USER_HERE>
RABBITMQ_PASSWORD=<PUT_YOUR_MQ_PASSWORD_HERE>
# Web interface port (Management UI)
RABBITMQ_UI_PORT=15672

# --- Server Configuration ---
# Service ports to avoid local conflicts during development
GATEWAY_PORT=:8080
TRIP_SERVICE_PORT=:8081
DRIVER_SERVICE_PORT=:8082
