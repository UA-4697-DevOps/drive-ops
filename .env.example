# --- Database Configuration ---
# PostgreSQL credentials (used by all services)
DB_USER=<YOUR_USER>
DB_PASSWORD=<YOUR_PASSWORD>
DB_HOST=drive-ops-db  # Docker container name
DB_PORT=5432

# Database names for specific services
TRIP_DB_NAME=trip_db
DRIVER_DB_NAME=driver_db

# Optional: Full DATABASE_URL (auto-constructed from above if not set)
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DRIVER_DB_NAME}

# --- Message Broker (RabbitMQ) ---
RABBITMQ_HOST=drive-ops-mq  # Docker container name
RABBITMQ_PORT=5672
RABBITMQ_USER=<YOUR_USER>
RABBITMQ_PASSWORD=<YOUR_PASSWORD>
# Web interface port (Management UI)
RABBITMQ_UI_PORT=15672

# --- Microservice: Client Gateway (Telegram Bot) ---
# Required for the bot to function
BOT_TOKEN=<PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE>
LOG_LEVEL=INFO

# --- Server Configuration ---
# Ports with colon format for service internal listeners
GATEWAY_PORT=:8080
TRIP_SERVICE_PORT=:8081
DRIVER_SERVICE_PORT=:8082

# --- Inter-Service Communication ---
# Internal URLs for microservices within the Docker network
GATEWAY_URL=http://client-gateway:8080
TRIP_SERVICE_URL=http://trip-service:8081
DRIVER_SERVICE_URL=http://driver-service:8082

# --- AWS / SQS Configuration ---
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>

# Unified endpoint for all services (leave empty for real AWS, use for LocalStack/Mock)
SQS_ENDPOINT=

# Explicit functional names for all FIFO queues
SQS_TRIP_CREATED_URL=https://sqs.us-east-2.amazonaws.com/.../trip-created-dev.fifo
SQS_DRIVER_ASSIGNED_URL=https://sqs.us-east-2.amazonaws.com/.../driver-assigned-dev.fifo
SQS_TRIP_COMPLETED_URL=https://sqs.us-east-2.amazonaws.com/.../trip-completed-dev.fifo
