# --- Database Configuration ---
# Use 'db' as host when running inside Docker
DB_HOST=db
DB_PORT=5432
DB_USER=<PUT_YOUR_DB_USER_HERE>
DB_PASSWORD=<PUT_YOUR_DB_PASSWORD_HERE>
# Database names for specific services
TRIP_DB_NAME=trip_db
DRIVER_DB_NAME=driver_db

# --- Message Broker (RabbitMQ) ---
# Use 'mq' as host when running inside Docker
RABBITMQ_HOST=mq
RABBITMQ_PORT=5672
RABBITMQ_USER=<PUT_YOUR_MQ_USER_HERE>
RABBITMQ_PASSWORD=<PUT_YOUR_MQ_PASSWORD_HERE>
# Web interface port (Management UI)
RABBITMQ_UI_PORT=15672

# --- Microservice: Client Gateway (Telegram Bot) ---
# Required for the bot to function
BOT_TOKEN=<PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE>
LOG_LEVEL=INFO

# --- Server Configuration ---
# Ports with colon format for service internal listeners
GATEWAY_PORT=:8080
TRIP_SERVICE_PORT=:8081
DRIVER_SERVICE_PORT=:8082

# --- Inter-Service Communication ---
# Use SERVICE_NAME:INTERNAL_PORT defined in docker-compose.yml
# Internal URLs for microservices communication within the Docker network
TRIP_SERVICE_URL=http://trip-service:8081
DRIVER_SERVICE_URL=http://driver-service:8082
