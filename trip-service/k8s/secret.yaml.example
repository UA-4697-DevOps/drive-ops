# Example Secret Configuration for Trip Service
# DO NOT commit actual secrets to Git!
#
# For local testing:
#   kubectl create secret generic trip-service-secrets \
#     --from-literal=database-url="postgresql://user:pass@host:5432/db?sslmode=require" \
#     -n dev
#
# For production, use one of:
#   - External Secrets Operator (recommended for EKS)
#   - AWS Secrets Manager with IRSA
#   - Sealed Secrets
#   - HashiCorp Vault
#
apiVersion: v1
kind: Secret
metadata:
  name: trip-service-secrets
  namespace: dev
  labels:
    app: trip-service
type: Opaque
stringData:
  # PostgreSQL/RDS connection string
  # Format: postgresql://username:password@hostname:port/database?sslmode=require
  database-url: "postgresql://CHANGE_ME:CHANGE_ME@trip-db.us-east-2.rds.amazonaws.com:5432/trip_db?sslmode=require"
