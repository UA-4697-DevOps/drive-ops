#!/bin/bash
# Pre-commit hook for drive-ops project

# Get list of staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

EXIT_CODE=0

echo "🔍 Running pre-commit formatting checks..."

# --- Phase 1: General Formatting (EOF Newlines) ---
while IFS= read -r FILE; do
    # Only check text-based files defined in project architecture
    if [[ "$FILE" =~ \.(py|go|hcl|tf|sh|yaml|yml|md|txt)$ ]]; then
        
        # Check if the file ends with a newline
        if [ -n "$(tail -c 1 "$FILE")" ]; then
            echo "🔧 Fixing missing EOF newline in: $FILE"
            
            # Append a newline to the file (Linux/macOS compatible)
            if sed --version >/dev/null 2>&1; then
                sed -i -e '$a\' "$FILE"
            else
                sed -i '' -e '$a\' "$FILE"
            fi
            
            # Re-stage the file so the fix is included in the commit
            git add "$FILE"
        fi
    fi
done <<< "$STAGED_FILES"

# --- Phase 2: Infrastructure Specific Checks ---
# If any infrastructure files were modified, run the global check script
if echo "$STAGED_FILES" | grep -q "^infra/"; then
    echo "🏗️ Infrastructure changes detected. Running validation..."
    
    # Execute the dedicated infrastructure check script
    bash infra/check-infra.sh
    
    # Capture the exit code of the check script
    IF_EXIT=$?
    if [ $IF_EXIT -ne 0 ]; then
        echo "❌ Infrastructure validation failed. Please fix the errors above."
        EXIT_CODE=$IF_EXIT
    fi
fi

echo "--- All pre-commit checks completed ---"
exit $EXIT_CODE
